  "dependencies": {
    "@aws-sdk/client-cloudfront": "^3.1042.0",
    "@aws-sdk/client-s3": "^3.1038.0",
    "@aws-sdk/lib-storage": "^3.1041.0",
    "archiver": "^7.0.1",
    "aws-sdk": "^2.1692.0",
    "child_process": "^1.0.2",
    "client-ec2": "github:aws-sdk/client-ec2",
    "fs": "^0.0.1-security",
    "jsonwebtoken": "^9.0.3",
    "mime-types": "^3.0.2",
    "protobufjs": "^8.7.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.8.1",
    "cross-env": "^10.1.0",
    "eslint": "^10.9.1",
    "globals": "^17.12.0"
  }
}
